{
  "name": "score-aligned-choir-cleanup",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "tauri": "tauri",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "npm run build:app && vite build --config vite.site.config.ts && node scripts/install-demo.mjs",
    "build": "npm run build:site",
    "preview:site": "vite preview --config vite.site.config.ts",
    "test": "vitest run && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "verify:copy": "node scripts/copy-audit.mjs",
    "verify:url": "bash scripts/verify-url.sh",
    "assets": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.15.30",
    "playwright-core": "^1.58.2",
    "sharp": "^0.35.4",
    "typescript": "5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
